DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"
SESSION_SECRET=change-me
SEED_ANCHOR_DATE=

# Insight AI (Phase 2). Server-only: never expose to the browser or commit a real key.
XAPI_KEY=your-xai-api-key
AI_MODEL=grok-4.7
# Used once if AI_MODEL fails before replying; set to "none" to disable.
AI_FALLBACK_MODEL=grok-4.6
AI_TIMEOUT_MS=30000
# low | medium | high | default — "low" keeps replies fast.
AI_REASONING_EFFORT=low
